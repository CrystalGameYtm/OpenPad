# /etc/udev/rules.d/70-gamepad-remapd.rules
#

#   1) /dev/hidrawN of the required gamepads/receivers — raw report reading, handshake, rumble;
#   2) /dev/uinput — creating the virtual gamepad.
#

#   TAG+="uaccess"       systemd-logind grants an ACL to the user of the local session (desktop).
#   GROUP="input",0660   for SSH/headless/systemd services:  sudo usermod -aG input $USER
#

#

#   sudo udevadm control --reload
#   sudo udevadm trigger --subsystem-match=hidraw --subsystem-match=misc

#   getfacl /dev/hidraw0 /dev/uinput
#   udevadm test "$(udevadm info -q path -n /dev/hidraw0)" 2>&1 | grep -i -E 'uaccess|GROUP|MODE'

# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", TAG+="uaccess", GROUP="input", MODE="0660"

# ---------------------------------------------------------------------------
# Sony DualShock 4 (reference layout sony_ds4_usb): v1 and v2.
# ---------------------------------------------------------------------------
SUBSYSTEM=="hidraw", SUBSYSTEMS=="usb", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="05c4", TAG+="uaccess", GROUP="input", MODE="0660"
SUBSYSTEM=="hidraw", SUBSYSTEMS=="usb", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="09cc", TAG+="uaccess", GROUP="input", MODE="0660"

# DualShock 4 / clones over Bluetooth: hidraw has no USB parent, so we match by the HID device name 0005:VID:PID.N
SUBSYSTEM=="hidraw", KERNELS=="0005:054C:05C4.*", TAG+="uaccess", GROUP="input", MODE="0660"
SUBSYSTEM=="hidraw", KERNELS=="0005:054C:09CC.*", TAG+="uaccess", GROUP="input", MODE="0660"



# ---------------------------------------------------------------------------
# 8BitDo (all their USB devices and 2.4 GHz receivers; VID 2dc8).
# ---------------------------------------------------------------------------
SUBSYSTEM=="hidraw", SUBSYSTEMS=="usb", ATTRS{idVendor}=="2dc8", TAG+="uaccess", GROUP="input", MODE="0660"

# ---------------------------------------------------------------------------
# Flydigi / GameSir / other 2.4 GHz receivers: each model has its own VID:PID.
#   1) lsusb                        -> find the receiver line, e.g. "ID 1234:abcd"
#   2) uncomment and substitute:
# SUBSYSTEM=="hidraw", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1234", ATTRS{idProduct}=="abcd", TAG+="uaccess", GROUP="input", MODE="0660"

#   gamepad-remapd udev-rules --vid-pid 1234:abcd | sudo tee /etc/udev/rules.d/70-gamepad-remapd.rules
#
# Bluetooth gamepads (hidraw via uhid) are matched differently (SUBSYSTEMS=="hid", KERNELS=="0005:VID:PID.*")

# ---------------------------------------------------------------------------
