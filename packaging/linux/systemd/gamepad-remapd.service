
#   mkdir -p ~/.config/systemd/user && cp gamepad-remapd.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now gamepad-remapd
#   journalctl --user -u gamepad-remapd -f

#


# systemd cannot raise the hard limit by itself, so LimitRTPRIO= is deliberately not set here.
[Unit]
Description=Gamepad remapper (hidraw -> uinput) + Web UI
After=graphical-session.target

[Service]
Type=simple

ExecStart=%h/.local/bin/gamepad-remapd serve
Restart=on-failure
RestartSec=2


RuntimeDirectory=gamepad-remapd
RuntimeDirectoryMode=0700


NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/gamepad-remapd
PrivateTmp=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=default.target
