  "rumble": {
    "_comment": "Bluetooth report 0x11 (78 bytes): [1]=0xC4 (HID 0x80 + CRC 0x40 + poll interval 4), [2]=audio 0, [3]=flags 0x01 motors only, [6]=right (weak), [7]=left (strong); in bytes 74..77 the CRC-32 of 0xA2 + report[0..73] (little-endian). Checked against what SDL3 writes to the GPS13B over Bluetooth (strace, `sdl-rumble --trace`): byte [1] must be 0xC4, with 0xC0 the clone ignores the report; the CRC matches byte for byte.",
    "op": "output",
    "template": "11 c4 00 01 00 00 {weak} {strong}",
    "pad_to": 78,
    "crc32": {
      "seed": "a2",
      "at": 74
    }
  }
